# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Playwright / 测试产物
test-results/
playwright-report/
data/debug/

# 运行日志（任务级，只增不改，本地取证用，不入库）
artifacts/*/journal.jsonl
.claude/journal_task

# 需求文档与设计图：**只留本地，绝不入库**
# 这是公开仓库，而接入方跑真实项目时喂给 agent 的需求文档 / 设计稿通常是未发布的机密。
# tools/prd_intake.py 的产物正好落在这两个目录，prd/ 是手动放原件的常见位置。
artifacts/*/input/
artifacts/*/ui_design/
prd/

# 编辑器
.idea/
.vscode/
.DS_Store

# 执行台账 / 断点续跑 / 止损记录（每次跑 pytest 自动写，只留本地）
artifacts/_runs/
